# Copy this to .env and fill values (don't commit .env to git!)
# Required for Render deploy:

GROQ_API_KEY=your_groq_api_key_here
SECRET_KEY=your-super-secret-key-here  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Optional:
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Render auto-sets:
# DATABASE_URL=postgres://... (PostgreSQL)
# PORT=10000

